# Copy to .env and fill in real values before `docker compose up`.
# .env itself is gitignored; never commit real secrets.

# Signs the JWTs. Must be a long random string (32+ characters), e.g.
# generated with: openssl rand -base64 48
JWT_SECRET=

# Password for the PostgreSQL `jobtracker` user inside the Compose stack.
# The backend reads the same value, so the two always match.
DB_PASSWORD=jobtracker
